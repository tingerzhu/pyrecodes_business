    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "def plot_total_revenue(total_revenue: list, save_fig: bool = True, show_fig: bool = True) -> None:\n",
    "    plt.figure(figsize=(14, 6))\n",
    "    plt.plot(total_revenue)\n",
    "    # add a shading area to show how much is the total lost revenue\n",
    "    upper_revenue_bound = [max(total_revenue)] * len(total_revenue)\n",
    "    fill_unmet_revenue(total_revenue, upper_revenue_bound, plt.gca())\n",
    "    plt.title(f'Total Business Revenue')\n",
    "    plt.xlabel('Days after the earthquake')\n",
    "    plt.ylabel('Revenue [$/day]')\n",
    "    plt.grid(True)\n",
    "    if save_fig:\n",
    "        plt.savefig(f'total_revenue.png', transparent=True, dpi=300)\n",
    "    if show_fig:\n",
    "        plt.show()\n",
    "\n",
    "def plot_total_revenue_BI_CBI(total_revenue: list, total_revenue_business_no_building_damage: list, save_fig: bool = True, show_fig: bool = True) -> None:\n",
    "    plt.figure(figsize=(14, 6))\n",
    "    plt.plot(total_revenue)\n",
    "    # add a shading area to show how much is the total lost revenue\n",
    "    upper_CBI_bound = [max(total_revenue)] * len(total_revenue)\n",
    "    lower_CBI_bound = [total_revenue_business_no_building_damage[i] + (upper_CBI_bound[i] - max(total_revenue_business_no_building_damage)) for i in range(len(total_revenue))]\n",
    "    fill_unmet_revenue(lower_CBI_bound, upper_CBI_bound, plt.gca(), lost_revenue_label='Lost revenue with no building damage (CBI): ')\n",
    "    fill_unmet_revenue(total_revenue, lower_CBI_bound, plt.gca(), lost_revenue_label='Lost revenue with building damage (BI): ', text_position=(0.95, 0.15))\n",
    "    plt.title(f'Total Business Revenue | BI vs CBI')\n",
    "    plt.xlabel('Days after the earthquake')\n",
    "    plt.ylabel('Revenue [$/day]')\n",
    "    plt.grid(True)\n",
    "    if save_fig:\n",
    "        plt.savefig(f'total_revenue_BI_CBI.png', transparent=True, dpi=300)\n",
    "    if show_fig:\n",
    "        plt.show()\n",
    "\n",
    "def calculate_total_revenue(business_resilience_calculator):\n",
    "    total_revenue = np.zeros(len(business_resilience_calculator.business_revenue[business_resilience_calculator.businesses[0]]))\n",
    "    for business in business_resilience_calculator.businesses:\n",
    "        total_revenue += np.array(business_resilience_calculator.business_revenue[business])\n",
    "    return total_revenue\n",
    "\n",
    "def calculate_total_business_with_no_building_damage_revenue(business_resilience_calculator):\n",
    "    total_revenue = np.zeros(len(business_resilience_calculator.business_revenue[business_resilience_calculator.businesses[0]]))\n",
    "    CBI_business = []\n",
    "    for business in business_resilience_calculator.businesses:\n",
    "        CBI_flag = True\n",
    "        for reasons in business.reason_for_drop.values():\n",
    "            for reason_at_time_step in reasons:\n",
    "                if reason_at_time_step['Name'] == 'Home Component Functionality' and reason_at_time_step['Level'] < 1:\n",
    "                    CBI_flag = False\n",
    "                    break\n",
    "        if CBI_flag:\n",
    "            CBI_business.append(business)\n",
    "    for business in CBI_business:\n",
    "        total_revenue += np.array(business_resilience_calculator.business_revenue[business])\n",
    "    return total_revenue\n",
