    "    all_business_reasons_for_drop = []\n",
    "    for business in all_businesses:\n",
    "        all_business_reasons_for_drop.append(get_reasons_for_drop(business, reasons_for_drop_names))\n",
    "    total_reasons_for_drop = {key: [] for key in reasons_for_drop_names}\n",
    "    for time_step in range(len(all_businesses[0].revenue)):\n",
    "        for reason_name in reasons_for_drop_names:\n",
    "            total_reasons_for_drop[reason_name].append({'Start': time_step, 'Duration': 1, 'Level': 0, 'Revenue': 0})\n",
    "            for business_reasons_for_drop in all_business_reasons_for_drop:\n",
    "                if reason_name in business_reasons_for_drop:\n",
    "                    total_reasons_for_drop[reason_name][time_step]['Revenue'] += business_reasons_for_drop[reason_name][time_step]['Revenue']\n",
    "    return total_reasons_for_drop   \n",
    "\n",
    "    \n",
    "\n",
    "\n",
    "def plot_total_reasons_for_drop_gantt(total_reasons_for_drop: list, x_axis_label='Days after the earthquake', save_fig: bool = True, show_fig: bool = False) -> None:\n",
    "    plt.figure(figsize=(14, 6))\n",
    "    axis_object = plt.gca()\n",
    "    plt.xlabel(x_axis_label)\n",
    "    for i, reason in enumerate(total_reasons_for_drop.values()):\n",
    "        y_center = i * GANTT_BAR_DISTANCE\n",
    "        for reason_time_step in reason:\n",
    "            bar_height = GANTT_BAR_WIDTH * reason_time_step['Drop']  # adjust width\n",
    "            Y_position = y_center - bar_height / 2 \n",
    "            axis_object.broken_barh([(reason_time_step['Start'], \n",
    "                                        reason_time_step['Duration'])], \n",
    "                                        (Y_position, GANTT_BAR_WIDTH*reason_time_step['Drop']),\n",
    "                edgecolor=\"none\") \n",
    "        \n",
    "    axis_object.set_yticks([(i) * GANTT_BAR_DISTANCE for i in range(len(list(total_reasons_for_drop.keys())))])\n",
    "    y_tick_labels = [REASON_LABELS.get(reason, reason) for reason in total_reasons_for_drop.keys()]\n",
    "    axis_object.set_yticklabels(y_tick_labels)\n",
    "    plt.grid(True)\n",
    "    if save_fig:\n",
    "        plt.savefig(f'total_gantt_chart.png', transparent=True, dpi=300)\n",
    "    if show_fig:\n",
    "        plt.show()\n",
    "    \n",
    "\n",
    "business_resilience_calculator = system.resilience_calculators[-1]\n",
    "total_revenue = calculate_total_revenue(business_resilience_calculator)\n",
    "total_revenue_business_no_building_damage = calculate_total_business_with_no_building_damage_revenue(business_resilience_calculator)\n",
    "plot_total_revenue(total_revenue)\n",
    "plot_total_revenue_BI_CBI(total_revenue, total_revenue_business_no_building_damage)\n",
    "total_reasons_for_drop = get_total_reasons_for_drop(business_resilience_calculator.businesses)\n",
    "total_reasons_for_drop_lines = get_reasons_for_drop_as_lines(total_reasons_for_drop)\n",
    "# plot_busines_revenue_reasons_for_drop_lines(business_to_plot, reasons_to_plot=['Home Component Functionality'], save_fig=False, show_fig=True)\n",
    "plot_busines_revenue_reasons_for_drop_lines(total_reasons_for_drop_lines)\n"
   ]
  },
